{
  "name": "claude-gui",
  "version": "0.2.97",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/postinstall.cjs",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npx vite --port 5173",
    "build": "node scripts/public-build.cjs build",
    "build:local": "cd client && npx vite build",
    "build:tauri": "node scripts/require-public-build.cjs && npm run build:local",
    "audit:public": "node scripts/audit-public.cjs",
    "smoke:http": "node scripts/check-http-smoke.cjs",
    "test:file-changes": "node scripts/check-file-changes.mjs",
    "test:session-trim": "node scripts/check-session-trim.mjs",
    "start": "NODE_ENV=production node server/index.js",
    "stop": "lsof -ti:6677 | xargs kill -9 2>/dev/null || true",
    "restart": "npm run stop && npm start",
    "tauri:dev": "cargo tauri dev",
    "tauri:build": "node scripts/public-build.cjs tauri"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.191",
    "chokidar": "^4.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "glob": "^11.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
