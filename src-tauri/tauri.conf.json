{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude GUI",
  "version": "0.2.248",
  "identifier": "com.claudegui.desktop",
  "build": {
    "beforeDevCommand": "npm run server",
    "devUrl": "http://127.0.0.1:6677",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../client/dist"
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/wsxwj123/claude-gui/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0QTgzRkFEOThFRUUzQTMKUldTajQrNllyVCtvTlA5QnFkNkIyVEpGSENIQ0dvMS9OVXAwUEZTbk9RQ21XeVBnRkJiM1JPa2EK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../server",
      "../client/dist",
      "../node_modules",
      "../package.json"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
